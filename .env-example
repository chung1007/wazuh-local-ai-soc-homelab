# Wazuh Manager API
WAZUH_API_URL=https://192.168.7.10:55000
WAZUH_API_USER=wazuh-wui
WAZUH_PASS=REPLACE_WITH_WAZUH_API_PASSWORD

# Wazuh Indexer through the local SSH tunnel
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=REPLACE_WITH_READ_ONLY_INDEXER_USER
WAZUH_INDEXER_PASS=REPLACE_WITH_INDEXER_PASSWORD

# Wazuh index patterns
WAZUH_ALERT_INDEX=wazuh-alerts-*
WAZUH_VULN_INDEX=wazuh-states-vulnerabilities-*

# Set to true after configuring trusted Wazuh CA certificates
VERIFY_SSL=false